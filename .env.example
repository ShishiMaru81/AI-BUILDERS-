DATABASE_URL=sqlite:///./agrosphere.db
DATA_MODE=DEMO
IMAGE_STORAGE_PATH=./storage
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
MODEL_DIR=../../ml/artifacts
MULTICROP_MODEL_DIR=../../ml/artifacts/multicrop
AGRODOCTOR_RESEARCH_MODEL_DIR=
AGRODOCTOR_RESEARCH_PRODUCE_MODEL_DIR=
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Docker Compose uses separate ports to preserve older/local applications.
WEB_PORT=3100
API_PORT=8100
DB_PORT=55432
# Netlify: set NEXT_PUBLIC_API_URL to the real public HTTPS backend URL + /api/v1.
# Keep DATABASE_URL and hosting tokens in the backend provider's secret settings.

# OTP delivery runs on the backend through Twilio Verify.
TWILIO_VERIFY_SERVICE_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Local alternative: Account SID/Auth Token. A complete API key pair takes priority.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Existing text-only demo login remains available locally. Hosted services default to off.
# ENABLE_DEMO_LOGIN=0

# A Fernet key for encrypted signup identity details and passport-style photos.
# Generate and store in the API environment only. Use a stable key across deploys.
SIGNUP_DATA_KEY=

# Free Gmail email verification (see docs/email-setup.md).
# Use a Google App Password; never your regular Google password.
# Keep AUTH_EMAIL_PROVIDER=twilio only if Twilio email is intentionally configured.
AUTH_EMAIL_PROVIDER=smtp
ENABLE_SMS_VERIFICATION=0
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_TLS_MODE=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Server-only AgroDoctor leaf and produce screening
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_CHAT_MODEL=qwen/qwen3.8-27b
GROQ_CHAT_FALLBACK_MODEL=openai/gpt-oss-120b
